generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COMPANY
  ADMIN
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  INTERVIEWING
  REJECTED
  ACCEPTED
}

enum DocumentType {
  CV
  LETTER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum InternshipType {
  FULL_TIME
  PART_TIME
  REMOTE
  HYBRID
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  otp           String?
  otpExpiry     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile StudentProfile?
  companyProfile CompanyProfile?
  matchScores      MatchScore[]    @relation("StudentMatchScores")
  jobPostings    JobPosting[]
  applications   Application[]
  documents      Document[]

  resetToken         String?
  resetTokenExpiry   DateTime?

  @@map("users")
}

model StudentProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  firstName          String
  lastName           String
  phone              String?
  university         String?
  yearOfStudy        Int?
  skills             String[]
  biography          String?            @db.Text
  courseOfStudy      String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  avatarUrl          String?
  coverUrl           String?
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model CompanyProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  companyName        String
  industry           String?
  description        String?            @db.Text
  website            String?
  logoUrl            String?
  coverUrl           String?
  location           String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model JobPosting {
  id                    String         @id @default(uuid())
  companyId             String
  title                 String
  description           String         @db.Text
  skillsRequired        String[]
  responsibilities      String[]
  academicRequirements  String?        @db.Text
  imageUrl              String?
  location              String?
  type                  InternshipType @default(FULL_TIME)
  isPaid                Boolean        @default(false)
  stipend               Float?
  duration              String?
  vacancies             Int            @default(1)
  deadline              DateTime?
  isActive              Boolean        @default(true)
  aiSummary             String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  company      User          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  matchScores   MatchScore[]

  @@index([companyId])
  @@index([isActive])
  @@map("job_postings")
}

model Application {
  id           String            @id @default(uuid())
  studentId    String
  jobPostingId String
  status       ApplicationStatus @default(PENDING)
  coverNote    String?           @db.Text
  aiInsight    String?           @db.Text
  appliedAt    DateTime          @default(now())
  shortlistedAt DateTime?
  interviewedAt DateTime?
  decidedAt    DateTime?
  updatedAt    DateTime          @updatedAt
  matchScore    Int?
  matchReason   String?

  student    User       @relation(fields: [studentId],    references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  documents  Document[]

  @@unique([studentId, jobPostingId])
  @@index([studentId])
  @@index([jobPostingId])
  @@index([status])
  @@map("applications")
}

model Document {
  id            String       @id @default(uuid())
  userId        String
  applicationId String?
  url           String
  type          DocumentType
  fileName      String
  fileSize      Int?
  mimeType      String?
  parsedContent String?      @db.Text
  aiParsedAt    DateTime?
  uploadedAt    DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User         @relation(fields: [userId],        references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@map("documents")
}

model MatchScore {
  id        String   @id @default(uuid())
  studentId String
  jobId     String
  score     Int
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   User       @relation("StudentMatchScores", fields: [studentId], references: [id], onDelete: Cascade)
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@map("match_scores")
}